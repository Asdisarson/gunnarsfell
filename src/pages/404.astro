---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getContent } from '../lib/wp';
import { BODY_CLASS } from '../site';

const { site, origin } = await getContent();
const title = `Page not found - ${site.name}`;
// Same head as WordPress's 404: not indexed, no canonical.
const seo = {
  title,
  robots: { index: 'noindex', follow: 'follow' },
  og_locale: 'is_IS',
  og_title: title,
  og_site_name: site.name,
  schema: {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        '@id': `${origin}/#website`,
        url: `${origin}/`,
        name: site.name,
        description: site.description,
        inLanguage: 'en-US',
      },
    ],
  },
};
---

<Base path="/404/" type="404" seo={seo} bodyClass={`error404 gf-page ${BODY_CLASS}`}>
  <main id="main" class="gf-main">
    <PageHead title="Þessi síða finnst ekki." />
    <section class="gf-section">
      <div class="gf-wrap">
        <p>Slóðin sem þú fylgdir virðist vera röng.</p>
        <div class="gf-actions gf-actions--page">
          <a class="gf-button" href="/">
            Fara á forsíðu
          </a>
          <a class="gf-link" href="/unnin-verk/">
            Skoða unnin verk
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>
