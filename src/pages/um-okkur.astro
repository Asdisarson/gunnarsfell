---
// Um okkur: the company, its two awards and the people to reach.
import Base from '../layouts/Base.astro';
import ContactSection from '../components/ContactSection.astro';
import PageHead from '../components/PageHead.astro';
import Reasons from '../components/Reasons.astro';
import { BODY_CLASS } from '../site';

const staff = [
  { name: 'Gunnar Árnason', email: 'gunnar@gunnarsfell.is' },
  { name: 'Serghei Glib', email: 'serghei@gunnarsfell.is' },
  { name: 'Sigurlaug D. Bjarnadóttir', email: 'sigurlaug@gunnarsfell.is' },
  { name: 'Ívar Hauksson', email: 'ivar@gunnarsfell.is' },
  { name: 'Piotr Lopotenco', email: 'piotr@gunnarsfell.is' },
  { name: 'Birgir Örn Sveinsson', email: 'birgir@gunnarsfell.is' },
  { name: 'Guðmundur E Einarssson', email: 'gudmundur@gunnarsfell.is' },
];
---

<Base path="/um-okkur/" type="page" bodyClass={`gf-page page-id-1048 ${BODY_CLASS}`}>
  <main id="main" class="gf-main">
    <PageHead title="Um Okkur" />

    <section class="gf-section" aria-labelledby="gf-company-title">
      <div class="gf-wrap gf-about">
        <div>
          <h2 id="gf-company-title">Gunnarsfell ehf</h2>
          <p>
            Gunnarsfell er verktakafyrirtæki sem var stofnað árið 2008 og starfa um 60 manns hjá fyrirtækinu. Fyrirtækið
            hefur frá stofnun tekið að sér ýmiss konar verk sem lúta m.a. að viðhaldi fasteigna, breytingum innanhúss,
            lóðaframkvæmdum, málningarvinnu, almennri pípulagningarvinnu og margt fleira. Einnig hefur fyrirtækið unnið
            að nýbyggingum og uppsetningu sumarhúsum og einingarhúsum undanfarin ár. Gunnarsfell hefur hlotið
            viðurkenningar fyrir fyrirmyndarfyrirtæki í rekstri og framúrskarandi fyrirtæki fyrir tímablið 2022-2025.
          </p>
        </div>
        <div class="gf-awards">
          <img
            src="/wp-content/uploads/2025/11/fyrirmyndar.png"
            srcset="/wp-content/uploads/2025/11/fyrirmyndar.png 476w, /wp-content/uploads/2025/11/fyrirmyndar-300x219.png 300w"
            sizes="(max-width: 767px) 42vw, 220px"
            width="476"
            height="348"
            alt="Fyrirmyndarfyrirtæki í rekstri"
            loading="lazy"
            decoding="async"
          />
          <img
            src="/wp-content/uploads/2023/10/RGB_FF-2023-Ice-Red-Vert-1024x987.png"
            srcset="/wp-content/uploads/2023/10/RGB_FF-2023-Ice-Red-Vert-1024x987.png 1024w, /wp-content/uploads/2023/10/RGB_FF-2023-Ice-Red-Vert-300x289.png 300w, /wp-content/uploads/2023/10/RGB_FF-2023-Ice-Red-Vert-768x740.png 768w"
            sizes="(max-width: 767px) 42vw, 220px"
            width="1024"
            height="987"
            alt="Framúrskarandi fyrirtæki"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="gf-section gf-section--mist" aria-labelledby="gf-staff-title">
      <div class="gf-wrap">
        <h2 id="gf-staff-title">Starfsfólk</h2>
        <ul class="gf-staff">
          {staff.map((person) => (
            <li>
              <h3>{person.name}</h3>
              <a href={`mailto:${person.email}`}>{person.email}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Reasons />
    <ContactSection />
  </main>
</Base>
