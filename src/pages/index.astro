---
// Home page: the finished work leads, then what the company does, why, what clients say, and contact.
import Base from '../layouts/Base.astro';
import ClientQuotes from '../components/ClientQuotes.astro';
import ContactSection from '../components/ContactSection.astro';
import HomeHero from '../components/HomeHero.astro';
import ProjectTile from '../components/ProjectTile.astro';
import Reasons from '../components/Reasons.astro';

import services from '../data/services.json';
import { featuredProjects } from '../lib/projects';
import { getContent } from '../lib/wp';
import { BODY_CLASS } from '../site';

const { verk } = await getContent();
// The first five fill the opening photo in turn; the next four sit in a row under it.
const HERO_SLIDES = 5;
const featured = featuredProjects(verk, HERO_SLIDES + 4);
---

<Base path="/" type="page" bodyClass={`home ${BODY_CLASS}`}>
  <main id="main" class="gf-main">
    <HomeHero projects={featured.slice(0, HERO_SLIDES)} />
    <section class="gf-more" aria-label="Fleiri verk">
      <div class="gf-more__tiles">
        {featured.slice(HERO_SLIDES).map((project) => (
          <ProjectTile project={project} sizes="(max-width: 767px) 50vw, 25vw" />
        ))}
      </div>
      <a class="gf-all" href="/unnin-verk/">
        Skoða öll {verk.length} verkin
      </a>
    </section>

    <section class="gf-section" aria-labelledby="gf-services-title">
      <div class="gf-wrap">
        <header class="gf-section__head">
          <h2 id="gf-services-title">Það sem við gerum</h2>
          <a class="gf-link" href="/thjonusta/">
            Sjá alla þjónustu
          </a>
        </header>
        <ul class="gf-services">
          {services.map((service) => (
            <li>
              <h3>{service.name}</h3>
              <p>{service.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Reasons />

    <ClientQuotes>
      <p>
        Við höfum notið velvildar og ánægju viðskiptavina okkar en Gunnarsfell leggur áherslu á vönduð vinnubrögð, góða
        umgengni á vinnustað og notum eingöngu viðkennd efni sem tryggja hámarksendingu og gæði.
      </p>
    </ClientQuotes>

    <ContactSection />
  </main>
</Base>
