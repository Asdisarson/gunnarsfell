---
// Þjónusta: every service with its photo, from src/data/services.json (shared with the home page).
import Base from '../layouts/Base.astro';
import ClientQuotes from '../components/ClientQuotes.astro';
import ContactSection from '../components/ContactSection.astro';
import PageHead from '../components/PageHead.astro';
import Reasons from '../components/Reasons.astro';

import services from '../data/services.json';
import { BODY_CLASS } from '../site';
---

<Base path="/thjonusta/" type="page" bodyClass={`gf-page page-id-1049 ${BODY_CLASS}`}>
  <main id="main" class="gf-main">
    <PageHead title="Þjónusta" />

    <section class="gf-section" aria-labelledby="gf-services-title">
      <div class="gf-wrap">
        <h2 id="gf-services-title">Treystu reynslunni</h2>
        <ul class="gf-cards">
          {services.map((service, i) => (
            <li>
              <img
                src={service.image.src}
                srcset={service.image.srcset}
                sizes="(max-width: 599px) 100vw, (max-width: 1024px) 50vw, 380px"
                width={service.image.width}
                height={service.image.height}
                alt=""
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <h3>{service.name}</h3>
              <p>{service.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <ClientQuotes />

    <Reasons />
    <ContactSection />
  </main>
</Base>
