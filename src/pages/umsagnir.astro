---
// Umsagnir: the three client testimonials at full length.
import Base from '../layouts/Base.astro';
import ContactSection from '../components/ContactSection.astro';
import PageHead from '../components/PageHead.astro';
import Reasons from '../components/Reasons.astro';
import testimonials from '../data/testimonials.json';
import { BODY_CLASS } from '../site';
---

<Base path="/umsagnir/" type="page" bodyClass={`gf-page page-id-10210 ${BODY_CLASS}`}>
  <main id="main" class="gf-main">
    <PageHead title="Umsagnir viðskiptavina" />

    <section class="gf-section">
      <div class="gf-wrap gf-voices">
        {testimonials.full.map((voice) => (
          <figure class="gf-voice">
            <img
              src={voice.image.src}
              srcset={voice.image.srcset}
              sizes="(max-width: 767px) 96px, 220px"
              width={voice.image.width}
              height={voice.image.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <div>
              <blockquote>
                <p>{voice.text}</p>
              </blockquote>
              <figcaption>{voice.name}</figcaption>
            </div>
          </figure>
        ))}
      </div>
    </section>

    <Reasons />
    <ContactSection />
  </main>
</Base>
