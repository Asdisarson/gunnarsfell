---
// One project: its cover photo behind the title, then every photo.
import Base from '../../layouts/Base.astro';
import ContactSection from '../../components/ContactSection.astro';
import PageHead from '../../components/PageHead.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import Reasons from '../../components/Reasons.astro';
import { getContent, type Project } from '../../lib/wp';
import { BODY_CLASS, projectDescription } from '../../site';

export async function getStaticPaths() {
  const { verk } = await getContent();
  return verk.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Base
  path={project.path}
  type="verk"
  seo={project.seo}
  fallbackDescription={projectDescription(project.title, project.description)}
  bodyClass={`gf-page single-verk postid-${project.id} ${BODY_CLASS}`}
>
  <main id="main" class="gf-main">
    <PageHead title={project.title} image={project.image ?? project.gallery[0]} projectId={project.id} />
    <section class="gf-section">
      <div class="gf-wrap">
        <ProjectGallery project={project} />
        <a class="gf-link" href="/unnin-verk/">
          Öll verkin
        </a>
      </div>
    </section>
    <Reasons />
    <ContactSection />
  </main>
</Base>
