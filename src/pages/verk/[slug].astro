                            <div class="elementor-widget-container">
                              <div class="elementor-icon-box-wrapper">
                                <div class="elementor-icon-box-icon">
                                  <span class="elementor-icon">
                                    <i aria-hidden="true" class="fas fa-hard-hat"></i>{' '}
                                  </span>
                                </div>
                                <div class="elementor-icon-box-content">
                                  <h6 class="elementor-icon-box-title">
                                    <span>Gæða efni </span>
                                  </h6>
                                  <p class="elementor-icon-box-description">
                                    Við notum eingöngu viðkennd efni sem tryggja hámarksendingu og gæði
                                  </p>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </section>
                </div>
              </div>
            </div>
          </section>
          <section
            class="elementor-section elementor-top-section elementor-element elementor-element-374ba5f3 elementor-section-boxed elementor-section-height-default elementor-section-height-default"
