---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import { getContent, type Project } from '../../lib/wp';
import { projectDescription } from '../../site';

export async function getStaticPaths() {
  const { verk } = await getContent();
  return verk.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const cover = project.image ? `background-image:url("${project.image.url}")` : undefined;
---

<Base
  path={project.path}
  type="verk"
  seo={project.seo}
  fallbackDescription={projectDescription(project.title, project.description)}
  bodyClass={`wp-singular verk-template-default single single-verk postid-${project.id} wp-custom-logo wp-theme-astra ehf-template-astra ehf-stylesheet-astra ast-page-builder-template ast-no-sidebar astra-4.11.7 ast-blog-single-style-1 ast-custom-post-type ast-single-post ast-inherit-site-logo-transparent ast-theme-transparent-header ast-hfb-header ast-full-width-layout ast-sticky-header-shrink ast-inherit-site-logo-sticky elementor-page-9467 ast-normal-title-enabled elementor-default elementor-kit-8 astra-addon-4.11.2`}
>
  <div class="ast-container">
    <div id="primary" class="content-area primary">
      <main id="main" class="site-main">
        <div
          data-elementor-type="single-post"
          data-elementor-id="9467"
          class={`elementor elementor-9467 elementor-location-single post-${project.id} verk type-verk status-publish has-post-thumbnail hentry ast-article-single`}
          data-elementor-post-type="elementor_library"
        >
          <section
            class="elementor-section elementor-top-section elementor-element elementor-element-5724572d elementor-section-boxed elementor-section-height-default elementor-section-height-default"
            data-id="5724572d"
            data-element_type="section"
            data-settings='&#123;"background_background":"classic"&#125;'
            style={cover}
          >
            <div class="elementor-background-overlay"></div>
            <div class="elementor-container elementor-column-gap-no">
              <div
                class="elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-6a5ae8cd"
                data-id="6a5ae8cd"
                data-element_type="column"
              >
                <div class="elementor-widget-wrap elementor-element-populated">
                  <div
                    class="elementor-element elementor-element-a862f1e elementor-widget elementor-widget-heading"
                    data-id="a862f1e"
                    data-element_type="widget"
                    data-widget_type="heading.default"
                  >
                    <div class="elementor-widget-container">
                      <h1 class="elementor-heading-title elementor-size-default">{project.title}</h1>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>
          <section
            class="elementor-section elementor-top-section elementor-element elementor-element-6fbefe3 elementor-section-boxed elementor-section-height-default elementor-section-height-default"
            data-id="6fbefe3"
            data-element_type="section"
          >
            <div class="elementor-container elementor-column-gap-default">
              <div
                class="elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-e51f3c3"
                data-id="e51f3c3"
                data-element_type="column"
