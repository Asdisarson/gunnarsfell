import ContactSection from '../components/ContactSection.astro';
import PageHead from '../components/PageHead.astro';
import { BODY_CLASS } from '../site';
---

<Base path="/hafa-samband/" type="page" bodyClass={`gf-page page-id-1050 ${BODY_CLASS}`}>
  <main id="main" class="gf-main">
    <PageHead title="Hafa Samband" />
    <ContactSection title="Ertu með fyrirspurn? Sendu okkur línu" lead="" />
  </main>
</Base>
