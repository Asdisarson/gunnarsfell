---
// A single testimonial. These pages exist in the old sitemap, so they keep their URLs.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getContent, type Testimonial } from '../../lib/wp';
import { BODY_CLASS } from '../../site';

export async function getStaticPaths() {
  const { umsogn } = await getContent();
  return umsogn.map((testimonial, i) => ({
    params: { slug: testimonial.slug },
    props: { testimonial, previous: umsogn[i - 1], next: umsogn[i + 1] },
  }));
}

interface Props {
  testimonial: Testimonial;
  previous?: Testimonial;
  next?: Testimonial;
}

const { testimonial, previous, next } = Astro.props;
const published = new Date(testimonial.date).toLocaleDateString('is-IS', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base
  path={testimonial.path}
  type="umsogn"
  seo={testimonial.seo}
  bodyClass={`gf-page single-umsogn postid-${testimonial.id} ${BODY_CLASS}`}
>
  <main id="main" class="gf-main">
    <PageHead title={testimonial.title} />
    <section class="gf-section">
      <div class="gf-wrap">
        <figure class="gf-voice gf-voice--single">
          <div>
            {/* The testimonial as written in WordPress, by the site's own editors. */}
            <blockquote set:html={testimonial.content} />
            <figcaption>
              {testimonial.role && <>{testimonial.role} / </>}
              <time datetime={testimonial.date}>{published}</time>
            </figcaption>
          </div>
        </figure>
        <nav class="gf-pager" aria-label="Umsagnir">
          {previous && (
            <a class="gf-link" title={previous.title} href={previous.path} rel="prev">
              Fyrri umsögn
            </a>
          )}
          {next && (
            <a class="gf-link" title={next.title} href={next.path} rel="next">
              Næsta umsögn
            </a>
          )}
          <a class="gf-link" href="/umsagnir/">
            Allar umsagnir
          </a>
        </nav>
      </div>
    </section>
  </main>
</Base>
