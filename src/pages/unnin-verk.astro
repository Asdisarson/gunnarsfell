---
// Unnin verk: every project, as a grid of cover photos.
import Base from '../layouts/Base.astro';
import ContactSection from '../components/ContactSection.astro';
import PageHead from '../components/PageHead.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { BODY_CLASS } from '../site';
---

<Base path="/unnin-verk/" type="page" bodyClass={`gf-page page-id-15 ${BODY_CLASS}`}>
  <main id="main" class="gf-main">
    <PageHead title="Unnin verk" />
    <section class="gf-section">
      <div class="gf-wrap">
        <ProjectGrid />
      </div>
    </section>
    <ContactSection />
  </main>
</Base>
