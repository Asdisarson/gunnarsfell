---
// Same markup and classes as the WPForms forms it replaces, so the existing form CSS applies.
// Submits to the WordPress contact endpoint (src/scripts/site.ts).
import { CONTACT_ENDPOINT } from '../lib/wp';

const id = 1043;
const size = 'wpforms-field-large';
const field = (n: number) => `wpforms-${id}-field_${n}`;
---

<div class="wpforms-container" id={`wpforms-${id}`}>
  <form
    id={`wpforms-form-${id}`}
    class="wpforms-validate wpforms-form"
    method="post"
    action={CONTACT_ENDPOINT}
    data-contact-form
    novalidate
  >
    <div class="wpforms-field-container">
      <div id={`${field(0)}-container`} class="wpforms-field wpforms-field-name">
        <label class="wpforms-field-label wpforms-label-hide" for={field(0)}>
          Nafn <span class="wpforms-required-label">*</span>
        </label>
        <input
          type="text"
          id={field(0)}
          class={`${size} wpforms-field-required`}
          name="nafn"
          placeholder="Fullt nafn"
          autocomplete="name"
          maxlength="100"
          required
        />
      </div>
      <div id={`${field(8)}-container`} class="wpforms-field wpforms-field-text">
        <label class="wpforms-field-label wpforms-label-hide" for={field(8)}>
          Símanúmer
        </label>
        <input
          type="tel"
          id={field(8)}
          class={size}
          name="simi"
          placeholder="Símanúmer"
          autocomplete="tel"
          maxlength="30"
        />
      </div>
      <>
        <div id={`${field(7)}-container`} class="wpforms-field wpforms-field-email">
          <label class="wpforms-field-label wpforms-label-hide" for={field(7)}>
            Netfang <span class="wpforms-required-label">*</span>
          </label>
          <input
            type="email"
            id={field(7)}
            class="wpforms-field-large wpforms-field-required"
            name="netfang"
            placeholder="Netfangið þitt"
            autocomplete="email"
            spellcheck="false"
            required
          />
        </div>
        <div id={`${field(5)}-container`} class="wpforms-field wpforms-field-text">
          <label class="wpforms-field-label wpforms-label-hide" for={field(5)}>
            Þjónusta
          </label>
          <input
            type="text"
            id={field(5)}
            class="wpforms-field-large"
            name="thjonusta"
            placeholder="Þjónusta "
            maxlength="150"
          />
        </div>
        <div id={`${field(2)}-container`} class="wpforms-field wpforms-field-textarea">
          <label class="wpforms-field-label wpforms-label-hide" for={field(2)}>
            Skilaboð <span class="wpforms-required-label">*</span>
          </label>
          <textarea
            id={field(2)}
            class="wpforms-field-medium wpforms-field-required"
            name="skilabod"
            placeholder="Skilaboð"
            maxlength="5000"
            required
          />
        </div>
      </>
      <!-- Bots fill this; people never see it. -->
      <div class="gf-hp" aria-hidden="true">
        <label for={`${field(99)}`}>Vefsíða</label>
        <input type="text" id={field(99)} name="vefsida" tabindex="-1" autocomplete="off" />
      </div>
    </div>
    <!-- Empty: keeps the spacing the reCAPTCHA row had between fields and button. -->
    <div class="wpforms-recaptcha-container wpforms-is-recaptcha wpforms-is-recaptcha-type-v3"></div>
    <div class="wpforms-submit-container">
      <input type="hidden" name="form" value="full" />
      <button
        type="submit"
        class="wpforms-submit"
        data-alt-text="Sendist..."
        data-submit-text="Senda"
        aria-live="assertive"
      >
        Senda
      </button>
    </div>
    <p class="gf-form-error" role="alert" hidden></p>
  </form>
</div>
