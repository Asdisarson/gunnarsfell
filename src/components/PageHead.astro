---
// The dark green band that opens every page except the home page: the page title, and for a
// project its cover photo behind it.
import type { WpImage } from '../lib/wp';

interface Props {
  /** The page's h1. */
  title: string;
  /** A photo behind the title. */
  image?: WpImage | null;
  /** The project this photo belongs to: the browser animates the clicked tile into this band (refresh.css). */
  projectId?: number;
}

const { title, image, projectId } = Astro.props;
---

<header class:list={['gf-pagehead', image && 'gf-pagehead--photo']}>
  {image && (
    <img
      class="gf-pagehead__photo"
      style={projectId ? `view-transition-name:verk-${projectId}` : undefined}
      src={image.url}
      srcset={image.srcset || undefined}
      sizes="(max-width: 767px) 140vw, 100vw"
      width={image.width}
      height={image.height}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  )}
  <div class="gf-wrap">
    <h1>{title}</h1>
  </div>
</header>
