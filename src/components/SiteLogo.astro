---
interface Props {
  path: string;
}
---

<div class="site-branding ast-site-identity" itemtype="https://schema.org/Organization" itemscope>
  <span class="site-logo-img">
    <a href="/" class="custom-logo-link" rel="home" aria-current={Astro.props.path === '/' ? 'page' : undefined}>
      <img
        width="175"
        height="91"
        src="/wp-content/uploads/2023/09/gunnarsfell-logo-175x91.png"
        class="custom-logo"
        alt="Gunnarsfell – Verktakar"
        decoding="async"
        srcset="/wp-content/uploads/2023/09/gunnarsfell-logo-175x91.png 175w, /wp-content/uploads/2023/09/gunnarsfell-logo-300x157.png 300w, /wp-content/uploads/2023/09/gunnarsfell-logo.png 749w"
        sizes="(max-width: 175px) 100vw, 175px"
      />
    </a>
  </span>
</div>
