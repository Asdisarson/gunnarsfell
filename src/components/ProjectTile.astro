---
// One project as a photo tile with its title and photo count; used wherever projects are listed.
import { coverOf, photoCount } from '../lib/projects';
import type { Project } from '../lib/wp';

interface Props {
  project: Project;
  /** The browser's `sizes` hint for where this tile sits in its grid. */
  sizes: string;
  /** Tiles on screen when the page opens load at once; the rest wait until they are scrolled to. */
  eager?: boolean;
  /** Heading level for the title, where the tile is an item in a list of projects. */
  heading?: 'h2' | 'h3';
  /** A line over the title, such as "Næsta verk". */
  label?: string;
}

const { project, sizes, eager = false, heading, label } = Astro.props;
const image = coverOf(project);
const shown = image?.sizes.large ?? image;
const Title = heading ?? 'span';
---

<a class="gf-tile" href={project.path}>
  {image && shown && (
    <img
      style={`view-transition-name:verk-${project.id}`}
      src={shown.url}
      srcset={image.srcset || undefined}
      sizes={sizes}
      width={shown.width}
      height={shown.height}
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  )}
  <span class="gf-tile__caption">
    {label && <span class="gf-tile__label">{label}</span>}
    <Title class="gf-tile__title">{project.title}</Title>
    {project.gallery.length > 0 && <span class="gf-tile__count">{photoCount(project.gallery.length)}</span>}
  </span>
</a>
