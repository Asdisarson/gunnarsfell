---
// The "Unnin verk" grid: every published project from WordPress, by title.
import ProjectTile from './ProjectTile.astro';
import { getContent } from '../lib/wp';

const { verk } = await getContent();
---

<ul class="gf-grid">
  {verk.map((project, i) => (
    <li>
      <ProjectTile
        project={project}
        heading="h2"
        eager={i < 6}
        sizes="(max-width: 767px) 50vw, (max-width: 1024px) 34vw, 390px"
      />
    </li>
  ))}
</ul>
