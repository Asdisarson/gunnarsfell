# WordPress (content admin). The build reads projects, testimonials, SEO data and images from here.
WP_URL=http://localhost:10009
# Public address of the static site.
SITE_URL=https://gunnarsfell.is
# Where the contact forms post. Defaults to WP_URL; in production this is the public WordPress address.
PUBLIC_CONTACT_ENDPOINT=http://localhost:10009/wp-json/gunnarsfell/v1/contact
# Tracking. Leave empty (as in local development) to leave the tag out.
# The live site's GA4 property is G-RD1CR3Z48N: set it for the production build.
PUBLIC_GA4_ID=
PUBLIC_FB_PIXEL_ID=
